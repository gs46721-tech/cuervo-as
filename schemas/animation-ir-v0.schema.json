          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "preset",
        "framing",
        "transform"
      ],
      "title": "Camera",
      "type": "object"
    },
    "CameraKeyframe": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "transform": {
