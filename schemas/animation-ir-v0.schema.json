{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gs46721-tech/cuervo-as/schemas/animation-ir-v0.schema.json",
  "title": "AnimationIRv0",
  "description": "Phase 0 Animation IR. An episode document or a timing patch. Timeline fields are integer frames.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "episode",
          "title": "Kind",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Episode Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "fps": {
          "maximum": 60,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "assets": {
          "$ref": "#/$defs/AssetLibrary"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "episode_id",
        "version",
        "title",
        "fps",
        "assets",
        "scenes"
      ],
      "title": "Episode",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A schema-valid timing edit.\n\nThe patch names the tracks it may move and how far the shot duration\ngrows. It does not carry pose, camera, or dialogue text changes.",
      "properties": {
        "kind": {
          "const": "timing_patch",
          "title": "Kind",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Patch Id",
          "type": "string"
        },
        "target_shot_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Target Shot Id",
          "type": "string"
        },
        "base_revision": {
          "pattern": "^rev-[0-9]{4,}$",
          "title": "Base Revision",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "timing": {
          "items": {
            "$ref": "#/$defs/TimingDelta"
          },
          "minItems": 1,
          "title": "Timing",
          "type": "array"
        },
        "extend_shot_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Extend Shot Frames",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "patch_id",
        "target_shot_id",
        "base_revision",
        "reason",
        "timing"
      ],
      "title": "TimingPatch",
      "type": "object"
    }
  ],
  "$defs": {
    "ActionKeyframe": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "pose": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Pose",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "pose"
      ],
      "title": "ActionKeyframe",
      "type": "object"
    },
    "ActionTrack": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Track Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pose",
            "gesture",
            "gaze",
            "expression",
            "locomotion",
            "secondary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_actor_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Target Actor Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "interpolation": {
          "enum": [
            "stepped",
            "linear",
            "ease_in_out"
          ],
          "title": "Interpolation",
          "type": "string"
        },
        "mask": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Mask",
          "type": "array"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "blend_mode": {
          "enum": [
            "override",
            "additive"
          ],
          "title": "Blend Mode",
          "type": "string"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/ActionKeyframe"
          },
          "minItems": 1,
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "track_id",
        "kind",
        "target_actor_id",
        "start_frame",
        "end_frame",
        "interpolation",
        "mask",
        "priority",
        "blend_mode",
        "keyframes"
      ],
      "title": "ActionTrack",
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Character Id",
          "type": "string"
        },
        "rig_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Rig Id",
          "type": "string"
        },
        "rig_instance_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Rig Instance Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Transform"
        },
        "facing": {
          "enum": [
            "front",
            "three_quarter_left",
            "three_quarter_right",
            "side_left",
            "side_right",
            "back"
          ],
          "title": "Facing",
          "type": "string"
        },
        "depth": {
          "title": "Depth",
          "type": "integer"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "character_id",
        "rig_id",
        "rig_instance_id",
        "stage",
        "facing",
        "depth"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AssetLibrary": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterAsset"
          },
          "minItems": 1,
          "title": "Characters",
          "type": "array"
        },
        "rigs": {
          "items": {
            "$ref": "#/$defs/RigAsset"
          },
          "minItems": 1,
          "title": "Rigs",
          "type": "array"
        },
        "backgrounds": {
          "items": {
            "$ref": "#/$defs/BackgroundAsset"
          },
          "minItems": 1,
          "title": "Backgrounds",
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/PropAsset"
          },
          "title": "Props",
          "type": "array"
        }
      },
      "required": [
        "characters",
        "rigs",
        "backgrounds"
      ],
      "title": "AssetLibrary",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
