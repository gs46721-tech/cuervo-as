        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
